FROM nvidia/cuda:11.8.0-cudnn8-devel-ubuntu22.04
ENV DEBIAN_FRONTEND=noninteractive

# 1. Dipendenze
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake wget python3 python3-pip python3-dev libopencv-dev \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --upgrade pip
RUN pip3 install fastapi uvicorn python-multipart numpy opencv-python requests pyyaml easydict onnx

# 2. Copiamo IL TUO codice locale invece di fare git clone!
WORKDIR /opt/darknet
COPY . /opt/darknet

# (Opzionale: se il tuo Makefile locale ha già GPU=1 ecc., non servono i sed!)
RUN sed -i 's/GPU=0/GPU=1/' Makefile && \
    sed -i 's/CUDNN=0/CUDNN=1/' Makefile && \
    sed -i 's/CUDNN_HALF=0/CUDNN_HALF=1/' Makefile && \
    sed -i 's/OPENCV=0/OPENCV=1/' Makefile && \
    sed -i 's/LIBSO=0/LIBSO=1/' Makefile

# Compiliamo la versione sicura
RUN make -j$(nproc)

# 3. Impostiamo la workdir su quella che tkTrain condividerà
WORKDIR /workspaces/darknet