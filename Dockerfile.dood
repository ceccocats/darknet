# 1. Catch the variable BEFORE the first FROM
ARG CU_VERSION=cu128

# 2. Map the variable to the correct base images
FROM nvidia/cuda:11.8.0-cudnn8-devel-ubuntu22.04 AS base-cu118
FROM nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04 AS base-cu128

# 3. Dynamically resolve the actual base image
FROM base-${CU_VERSION}

ENV DEBIAN_FRONTEND=noninteractive

# 4. Dipendenze
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake wget python3 python3-pip python3-dev libopencv-dev \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --upgrade pip
RUN pip3 install fastapi uvicorn python-multipart numpy opencv-python requests pyyaml easydict onnx

# 5. Copiamo IL TUO codice locale invece di fare git clone!
WORKDIR /opt/darknet
COPY . /opt/darknet

# Abilitiamo GPU, cuDNN e Tensor Cores (CUDNN_HALF)
RUN sed -i 's/GPU=0/GPU=1/' Makefile && \
    sed -i 's/CUDNN=0/CUDNN=1/' Makefile && \
    sed -i 's/CUDNN_HALF=0/CUDNN_HALF=1/' Makefile && \
    sed -i 's/OPENCV=0/OPENCV=1/' Makefile && \
    sed -i 's/LIBSO=0/LIBSO=1/' Makefile

# Compiliamo la versione sicura
# Compiliamo la versione sicura forzando architetture moderne (Ada/Hopper/Blackwell)
RUN make ARCH="-gencode arch=compute_89,code=[sm_89,compute_89] -gencode arch=compute_90,code=[sm_90,compute_90]" -j$(nproc)
# 6. Impostiamo la workdir su quella che tkTrain condividerà
WORKDIR /workspaces/darknet